#!/usr/bin/env python3
"""noctalia hook: reconcile greeter wallpaper paths with the shell's state.

The event-driven greeter-wallpaper-follow misses wallpaper changes on
connectors that are disabled when the change happens (e.g. rotation firing
while the laptop lid is closed and eDP-1 is off), so /var/lib/noctalia-greeter/
sync.toml drifts from the desktop. This wrapper reads the shell's authoritative
per-monitor wallpaper state (~/.local/state/noctalia/settings.toml) and replays
greeter-wallpaper-follow once per connector (plus the global entry), reusing
its surgical rewrite, ALLOWED_ROOT guard, and logging.

Intended hooks: `started` and `session_unlocked` (config.toml [hooks]).
Manual run is safe and idempotent: `greeter-wallpaper-reconcile`.
"""
import os
import pathlib
import subprocess
import sys
import tomllib

SETTINGS = pathlib.Path.home() / ".local" / "state" / "noctalia" / "settings.toml"
FOLLOW = pathlib.Path.home() / ".local" / "bin" / "greeter-wallpaper-follow"


def main() -> int:
    try:
        with SETTINGS.open("rb") as f:
            state = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as e:
        # Never fail loudly from a hook; the follow hook keeps working regardless.
        print(f"reconcile: cannot read {SETTINGS}: {e}", file=sys.stderr)
        return 0

    wall = state.get("wallpaper") or {}
    jobs: list[tuple[str, str]] = []

    # Global entry first: [appearance.wallpaper] follows the shell's "last".
    global_path = ((wall.get("last") or wall.get("default")) or {}).get("path")
    if global_path:
        jobs.append((global_path, ""))

    # Then every connector the shell tracks, enabled or not — that is the drift.
    for conn, cfg in (wall.get("monitors") or {}).items():
        path = (cfg or {}).get("path")
        if path:
            jobs.append((path, conn))

    env = dict(os.environ)
    for path, conn in jobs:
        env["NOCTALIA_WALLPAPER_PATH"] = path
        env["NOCTALIA_WALLPAPER_CONNECTOR"] = conn
        subprocess.run([str(FOLLOW)], env=env, check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
